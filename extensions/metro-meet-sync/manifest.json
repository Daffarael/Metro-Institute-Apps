{
  "manifest_version": 3,
  "name": "Metro Institute - Meet Auto Attendance",
  "version": "1.0.0",
  "description": "Otomatis mendeteksi peserta Google Meet dan mengirimkan data kehadiran langsung ke database Metro Institute tanpa perlu upload file CSV manual.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Metro Institute Meet Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.metroinstitute.site/*",
    "http://localhost:5000/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}
